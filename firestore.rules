rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Propriétaire principal : reconnu directement par Firebase Auth.
    function isOwner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'benoit2568@hotmail.com';
    }

    function myUserExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return myUserExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'employee';
    }

    function isAdmin() {
      return isOwner() || (signedIn() && myRole() == 'admin');
    }

    function isForeman() {
      return signedIn() && myRole() == 'foreman';
    }

    function canManageTime() {
      return isAdmin() || isForeman();
    }

    // =========================
    // UTILISATEURS
    // =========================
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.auth.uid == userId;

      // Admin/propriétaire : contrôle total.
      // Utilisateur normal : peut modifier son profil, mais pas son rôle.
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
      );

      allow delete: if isAdmin();
    }

    // =========================
    // CHANTIERS / PROJETS
    // =========================
    match /sites/{siteId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // =========================
    // PUNCHS / HEURES
    // =========================
    match /punches/{punchId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if canManageTime() || (
        signedIn()
        && resource.data.userId == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // =========================
    // DEMANDES DE CORRECTION
    // =========================
    match /correctionRequests/{requestId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if canManageTime();
      allow delete: if isAdmin();
    }

    // =========================
    // NOTES QUOTIDIENNES
    // =========================
    match /dailyNotes/{noteId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if canManageTime() || (
        signedIn()
        && resource.data.userId == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // =========================
    // PRÉSENCE
    // =========================
    match /presence/{userId} {
      allow read: if signedIn();

      allow create, update: if signedIn() && (
        request.auth.uid == userId
        || canManageTime()
      );

      allow delete: if canManageTime();
    }

    // =========================
    // PARAMÈTRES
    // =========================
    match /settings/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
