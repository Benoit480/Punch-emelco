rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return signedIn() && myUser().exists() ? myUser().data.role : 'employee';
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    function isForeman() {
      return signedIn() && myRole() == 'foreman';
    }

    function canManageTime() {
      return isAdmin() || isForeman();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role
        )
      );
      allow delete: if isAdmin();
    }

    match /sites/{siteId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /punches/{punchId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn() && (
        canManageTime() ||
        resource.data.userId == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    match /correctionRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if canManageTime();
      allow delete: if isAdmin();
    }

    match /dailyNotes/{noteId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if canManageTime() || resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /presence/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && (request.auth.uid == userId || canManageTime());
      allow delete: if canManageTime();
    }

    match /settings/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
